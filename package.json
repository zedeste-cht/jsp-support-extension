{
  "name": "support-jsp",
  "displayName": "JSP Support for vscode",
  "description": "JSP language support: go to Java/JavaScript definitions across Maven/Gradle multi-module projects and jars",
  "version": "0.1.0",
  "publisher": "zedeste",
  "icon": "icon.png",
  "author": {
    "name": "zedeste",
    "email": "zedeste@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zedeste-cht/jsp-support-extension"
  },
  "keywords": [
    "jsp"
  ],
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:jsp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jsp",
        "aliases": [
          "JavaServer Pages",
          "jsp"
        ],
        "extensions": [
          ".jsp",
          ".jspx",
          ".jspf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jsp",
        "scopeName": "text.html.jsp",
        "path": "./syntaxes/jsp.tmLanguage.json",
        "embeddedLanguages": {
          "source.java": "java",
          "source.js": "javascript",
          "source.css": "css",
          "text.html": "html"
        }
      }
    ],
    "snippets": [
      {
        "language": "jsp",
        "path": "./snippets/jsp.json"
      }
    ],
    "commands": [
      {
        "command": "jsp-support.goToJavaDefinition",
        "title": "Go to Java Definition",
        "category": "JSP"
      },
      {
        "command": "jsp-support.showLog",
        "title": "Show Log",
        "category": "JSP"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == jsp && editorTextFocus",
          "command": "jsp-support.goToJavaDefinition",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "JSP Support",
      "properties": {
        "jsp-support.javaSourcePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra Java source folders (relative to each module/workspace folder) to search, in addition to those detected from pom.xml / build.gradle."
        },
        "jsp-support.javaHome": {
          "type": "string",
          "default": "",
          "description": "JDK home used to find src.zip when jdt.ls is not available. Falls back to java.jdt.ls.java.home, the default java.configuration.runtimes entry and JAVA_HOME."
        },
        "jsp-support.mavenRepository": {
          "type": "string",
          "default": "",
          "description": "Local Maven repository. Defaults to <localRepository> from ~/.m2/settings.xml, then ~/.m2/repository."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run test:unit",
    "test:unit": "node esbuild.js && tsc -p . --outDir out && mocha \"out/test/unit/**/*.test.js\"",
    "test:vscode": "vscode-test"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "adm-zip": "^0.5.16",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "vscode-html-languageservice": "^5.1.0",
    "web-tree-sitter": "^0.25.10"
  }
}
